default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    # Authenticate with App Store Connect API
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      in_house: false
    )

    # Automatically manage code signing with match
    setup_ci if ENV['CI']

    # Sync code signing certificates and profiles
    match(
      type: "appstore",
      readonly: is_ci,
      app_identifier: "com.cairnapp.cairnreader"
    )

    # Increment build number
    increment_build_number(
      xcodeproj: "cairnreader.xcodeproj"
    )

    # Build the app
    build_app(
      workspace: "cairnreader.xcworkspace",
      scheme: "cairnreader",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.cairnapp.cairnreader" => "match AppStore com.cairnapp.cairnreader"
        }
      }
    )

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Download certificates and profiles"
  lane :certificates do
    match(
      type: "appstore",
      app_identifier: "com.cairnapp.cairnreader"
    )
  end

  desc "Test local build without uploading"
  lane :build_only do
    setup_ci if ENV['CI']

    match(
      type: "appstore",
      readonly: is_ci,
      app_identifier: "com.cairnapp.cairnreader"
    )

    increment_build_number(
      xcodeproj: "cairnreader.xcodeproj"
    )

    build_app(
      workspace: "cairnreader.xcworkspace",
      scheme: "cairnreader",
      export_method: "app-store"
    )
  end
end
