default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    # Authenticate with App Store Connect API
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      in_house: false
    )

    # Automatically manage code signing with match
    setup_ci if ENV['CI']

    # Sync code signing certificates and profiles
    match(
      type: "appstore",
      readonly: is_ci,
      app_identifier: "com.cairnapp.cairnreader"
    )

    # Set code signing settings on the Xcode project (needed after expo prebuild --clean)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "CairnReader.xcodeproj",
      team_id: ENV["TEAM_ID"],
      bundle_identifier: "com.cairnapp.cairnreader",
      code_sign_identity: "iPhone Distribution",
      profile_name: ENV["sigh_com.cairnapp.cairnreader_appstore_profile-name"]
    )

    # Fetch latest build number from TestFlight and increment by 1
    # This ensures build numbers persist across CI runs even though
    # expo prebuild --clean regenerates the Xcode project
    current_build = latest_testflight_build_number(
      app_identifier: "com.cairnapp.cairnreader"
    )
    increment_build_number(
      xcodeproj: "CairnReader.xcodeproj",
      build_number: current_build + 1
    )

    # Build the app
    build_app(
      workspace: "CairnReader.xcworkspace",
      scheme: "CairnReader",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.cairnapp.cairnreader" => "match AppStore com.cairnapp.cairnreader"
        }
      }
    )

    # Upload to TestFlight
    # verbose: true is required for Xcode 26 to detect silent altool failures
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      verbose: true
    )
  end

  desc "Download certificates and profiles"
  lane :certificates do
    match(
      type: "appstore",
      app_identifier: "com.cairnapp.cairnreader"
    )
  end

  desc "Test local build without uploading"
  lane :build_only do
    setup_ci if ENV['CI']

    match(
      type: "appstore",
      readonly: is_ci,
      app_identifier: "com.cairnapp.cairnreader"
    )

    # Set code signing settings on the Xcode project (needed after expo prebuild --clean)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "CairnReader.xcodeproj",
      team_id: ENV["TEAM_ID"],
      bundle_identifier: "com.cairnapp.cairnreader",
      code_sign_identity: "iPhone Distribution",
      profile_name: ENV["sigh_com.cairnapp.cairnreader_appstore_profile-name"]
    )

    # Fetch latest build number from TestFlight and increment by 1
    current_build = latest_testflight_build_number(
      app_identifier: "com.cairnapp.cairnreader"
    )
    increment_build_number(
      xcodeproj: "CairnReader.xcodeproj",
      build_number: current_build + 1
    )

    build_app(
      workspace: "CairnReader.xcworkspace",
      scheme: "CairnReader",
      export_method: "app-store"
    )
  end
end
