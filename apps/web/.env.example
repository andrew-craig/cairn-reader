# Local development backend override.
#
# In production the SPA is served from the same origin as the API, so no config
# is needed. For `npm run dev` (Vite serves on its own origin, which has no API)
# copy this file to `.env` and point it at a backend.
#
# Examples:
#   VITE_API_URL=http://localhost:8099        # local selfhost binary
#   VITE_API_URL=https://cairn.seatrain.net   # a remote instance
VITE_API_URL=http://localhost:8099
