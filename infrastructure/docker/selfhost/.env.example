# Cairn Self-Hosted Configuration
# Copy this file to .env and set DB_PASSWORD before starting.

# Required: set a secure database password
DB_PASSWORD=change-me

# Optional: all settings below have sensible defaults

# Image version to run. Pin to a published release (e.g. 1.2.3, or the
# floating 1.2 / 1 tags) for reproducible upgrades; defaults to "latest".
# See https://github.com/cairn-app/cairn-reader/pkgs/container/cairn-selfhost
# CAIRN_VERSION=latest

# DB_HOST=cairn-db
# DB_PORT=5432
# DB_USER=cairn
# DB_SSLMODE=disable

# PORT=8099

# JWT keys are auto-generated on first run and stored in /data/keys/
# JWT_PRIVATE_KEY_FILE=/data/keys/private.pem
# JWT_PUBLIC_KEY_FILE=/data/keys/public.pem
# JWT_AUTO_GENERATE=true
# JWT_ACCESS_EXPIRY=15m
# JWT_REFRESH_EXPIRY=168h

# INTERNAL_API_KEY=            # auto-generated if not set
# BCRYPT_COST=12

# Email ingest API key. The selfhost binary upserts this value into the
# api_keys table on startup (under the name "selfhost-default") so the
# Cloudflare Email Worker can authenticate against POST /api/v1/source/email/ingest.
# If unset, an ephemeral key is generated on each start and logged at WARN.
# Set this to a stable secret and configure your Email Worker with the same value.
# INGEST_API_KEY=

# EMAIL_DOMAIN=read.cairnapp.com

# Explore feed list source.
# If a file exists at FEED_LIST_PATH (inside the container) it is used;
# otherwise FEED_LIST_URL is downloaded at startup. Drop your own list
# into the cairn_data volume at /data/feeds/feeds.txt to override.
# FEED_LIST_PATH=/data/feeds/feeds.txt
# FEED_LIST_URL=https://raw.githubusercontent.com/cairn-app/cairn-reader/main/services/explore/feeds/default-feeds.txt
# FETCH_INTERVAL=60s
# ARTICLE_RETENTION_DAYS=90

# LOG_LEVEL=info
# LOG_FORMAT=text

# ─── PostgreSQL tuning ──────────────────────────────────────────────────────
# Defaults below are sized for a small host (~512MB RAM available to Postgres).
# Raise these if you run on larger hardware or see "out of shared memory" /
# "too many connections" errors. See:
# https://www.postgresql.org/docs/18/runtime-config-resource.html
#
# POSTGRES_MAX_CONNECTIONS=20
# POSTGRES_SHARED_BUFFERS=16MB
# POSTGRES_WORK_MEM=512kB
# POSTGRES_MAINTENANCE_WORK_MEM=16MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=128MB
# POSTGRES_WAL_BUFFERS=512kB
# POSTGRES_MIN_WAL_SIZE=32MB
# POSTGRES_MAX_WAL_SIZE=256MB
# POSTGRES_SHM_SIZE=64mb
#
# Per-service connection pool caps. The sum across all 6 services must stay
# under POSTGRES_MAX_CONNECTIONS. Default: 6 * 3 = 18 < 20.
# DB_MAX_CONNS=3
# DB_MIN_CONNS=1
