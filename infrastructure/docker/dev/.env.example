# HashiCorp Vault Configuration
VAULT_DEV_ROOT_TOKEN_ID=your_vault_token_here

# Consolidated PostgreSQL Admin (used by init-databases.sh)
POSTGRES_ADMIN_USER=cairn_admin
POSTGRES_ADMIN_PASSWORD=your_admin_db_password_here

# User Service Database Configuration
POSTGRES_USER_USERS=cairn_user
POSTGRES_PASSWORD_USERS=your_users_db_password_here
POSTGRES_DB_USERS=cairn_users

# Recommender Service Database Configuration
POSTGRES_USER_RECOMMENDER=cairn_recommender
POSTGRES_PASSWORD_RECOMMENDER=your_recommender_db_password_here
POSTGRES_DB_RECOMMENDER=cairn_recommender

# Fetcher Service Database Configuration
POSTGRES_USER_FETCHER=cairn_fetcher
POSTGRES_PASSWORD_FETCHER=your_fetcher_db_password_here
POSTGRES_DB_FETCHER=cairn_fetcher

# Content Service Database Configuration
POSTGRES_USER_CONTENT=cairn_content
POSTGRES_PASSWORD_CONTENT=your_content_db_password_here
POSTGRES_DB_CONTENT=content_service

# RSS Fetcher Service Database Configuration
POSTGRES_USER_RSS=cairn_rss
POSTGRES_PASSWORD_RSS=your_rss_db_password_here
POSTGRES_DB_RSS=rss_fetcher_service

# Service-to-Service Authentication
# Shared API key for internal service communication (content-service <-> ingest-rss-worker)
INTERNAL_API_KEY=your_internal_api_key_here
