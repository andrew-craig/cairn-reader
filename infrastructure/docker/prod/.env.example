# Production Environment Variables
# Copy this file to .env and update with your values

# GitHub Container Registry Configuration
# Replace 'cairn-app' with your GitHub username or organization
GITHUB_ORG=cairn-app

# Image Tag - Options:
# - latest (recommended for staging/dev)
# - v1.0.0 (specific version for production)
# - main (latest from main branch)
# - develop (latest from develop branch)
IMAGE_TAG=latest

# =============================================================================
# HashiCorp Vault AppRole Credentials
# =============================================================================
# These credentials are generated by the vault-init container on first startup.
# After first run, retrieve values from /vault-keys/approle-credentials.env
# and update these variables.
#
# IMPORTANT: Each service has its own AppRole with scoped permissions:
# - user-service: Can read both private and public JWT keys
# - explore-recommender: Can only read the public JWT key
#
# DO NOT use root tokens in production!
# =============================================================================

# User Service AppRole Credentials
# (generated by vault-init, retrieve from /vault-keys/approle-credentials.env)
USER_SERVICE_ROLE_ID=
USER_SERVICE_SECRET_ID=

# Explore Recommender AppRole Credentials
# (generated by vault-init, retrieve from /vault-keys/approle-credentials.env)
EXPLORE_RECOMMENDER_ROLE_ID=
EXPLORE_RECOMMENDER_SECRET_ID=

# Content Service AppRole Credentials
# (generated by vault-init, retrieve from /vault-keys/approle-credentials.env)
CONTENT_SERVICE_ROLE_ID=
CONTENT_SERVICE_SECRET_ID=

# =============================================================================
# Database Credentials
# =============================================================================
# IMPORTANT: Change all passwords before deploying to production!

# Consolidated PostgreSQL Admin (used by init-databases.sh)
POSTGRES_ADMIN_USER=cairn_admin
POSTGRES_ADMIN_PASSWORD=change-this-admin-password-in-production

# User Service Database
POSTGRES_USER_USERS=cairn_user
POSTGRES_PASSWORD_USERS=change-this-password-in-production
POSTGRES_DB_USERS=cairn_users

# Explore Recommender Database
POSTGRES_USER_RECOMMENDER=cairn_recommender
POSTGRES_PASSWORD_RECOMMENDER=change-this-password-in-production
POSTGRES_DB_RECOMMENDER=cairn_recommender

# Explore Fetcher Database
POSTGRES_USER_FETCHER=cairn_fetcher
POSTGRES_PASSWORD_FETCHER=change-this-password-in-production
POSTGRES_DB_FETCHER=cairn_fetcher

# Content Service Database
POSTGRES_USER_CONTENT=cairn_content
POSTGRES_PASSWORD_CONTENT=change-this-password-in-production
POSTGRES_DB_CONTENT=content_service

# Ingest RSS Database
POSTGRES_USER_RSS=cairn_rss
POSTGRES_PASSWORD_RSS=change-this-password-in-production
POSTGRES_DB_RSS=rss_fetcher_service

# =============================================================================
# Service-to-Service Authentication
# =============================================================================
# Shared API key for internal service communication (content-service <-> ingest-rss-worker)
# IMPORTANT: Generate a strong random key before deploying to production!
INTERNAL_API_KEY=change-this-api-key-in-production
