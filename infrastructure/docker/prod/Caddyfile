# Cairn Production Reverse Proxy Configuration
# Serving plain HTTP on port 8080 — TLS is terminated by the host nginx reverse proxy.

http://:8080 {
	# ──────────────────────────────────────────────
	# Security Headers
	# ──────────────────────────────────────────────
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# ──────────────────────────────────────────────
	# Block internal/admin endpoints from public access
	# ──────────────────────────────────────────────
	handle /api/v1/internal/* {
		respond "Not Found" 404
	}

	# Explore Fetcher admin endpoints are internal-only
	handle /api/v1/explore/feed/* {
		respond "Not Found" 404
	}

	# RSS ingest is service-to-service only
	handle /api/v1/source/rss/* {
		respond "Not Found" 404
	}

	# ──────────────────────────────────────────────
	# User Service — Authentication & account management
	# ──────────────────────────────────────────────
	handle /api/v1/auth/* {
		reverse_proxy user-service:8080 {
			header_up X-Forwarded-Proto https
		}
	}

	handle /api/v1/user/* {
		reverse_proxy user-service:8080 {
			header_up X-Forwarded-Proto https
		}
	}

	# ──────────────────────────────────────────────
	# Explore Recommender — Recommendations & voting
	# ──────────────────────────────────────────────
	handle /api/v1/explore/* {
		reverse_proxy explore-recommender:8081 {
			header_up X-Forwarded-Proto https
		}
	}

	# ──────────────────────────────────────────────
	# Content Service — Article storage (user-facing)
	# ──────────────────────────────────────────────
	handle /api/v1/content/* {
		reverse_proxy content-service:8080 {
			header_up X-Forwarded-Proto https
		}
	}

	# ──────────────────────────────────────────────
	# Email Ingest — Email address management & webhook
	# ──────────────────────────────────────────────
	handle /api/v1/source/email/* {
		reverse_proxy email-ingest:8087 {
			header_up X-Forwarded-Proto https
		}
	}

	# ──────────────────────────────────────────────
	# Health check (aggregated via user-service)
	# ──────────────────────────────────────────────
	handle /health/* {
		reverse_proxy user-service:8080 {
			header_up X-Forwarded-Proto https
		}
	}

	# ──────────────────────────────────────────────
	# Default — reject unmatched paths
	# ──────────────────────────────────────────────
	handle {
		respond "Not Found" 404
	}
}
