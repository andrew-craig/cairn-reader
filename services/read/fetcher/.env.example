# Ingest RSS Service Configuration
# Copy this file to .env and update the values as needed

# Database Configuration
DATABASE_URL=postgres://rss_user:rss_pass@localhost:5433/ingest_rss?sslmode=disable

# Server Configuration
PORT=8081
HOST=0.0.0.0

# Content Service Integration
CONTENT_SERVICE_URL=http://localhost:8080
CONTENT_SERVICE_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=info

# Feed Polling Configuration
POLL_INTERVAL_ACTIVE_HOURS=1
POLL_INTERVAL_MODERATE_HOURS=6
POLL_INTERVAL_QUIET_HOURS=24
WORKER_POOL_SIZE=10

# Feed Processing
FEED_FETCH_TIMEOUT_SECONDS=30
ARTICLE_FETCH_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# Outbox Delivery Configuration
OUTBOX_WORKER_INTERVAL_SECONDS=60
OUTBOX_MAX_RETRIES=6

# Circuit Breaker Configuration
CIRCUIT_BREAKER_MAX_FAILURES=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=30

# Migration Configuration
RUN_MIGRATIONS_ON_STARTUP=false
