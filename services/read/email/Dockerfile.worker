# Build stage
FROM golang:1.24-alpine AS builder

# Set GOTOOLCHAIN to auto to allow using newer Go versions
ENV GOTOOLCHAIN=auto

# Install build dependencies
RUN apk add --no-cache git

# Set working directory
WORKDIR /build

# Copy go mod files and shared packages
COPY services/read/email/go.mod services/read/email/go.sum ./services/read/email/
COPY pkg/ ./pkg/

# Download dependencies
WORKDIR /build/services/read/email
RUN go mod download

# Copy source code
WORKDIR /build
COPY services/read/email/ ./services/read/email/

# Build the worker application
WORKDIR /build/services/read/email
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o /build/email-ingest-worker ./cmd/email_ingest_worker

# Final stage
FROM alpine:latest

# Install ca-certificates for HTTPS
RUN apk --no-cache add ca-certificates

# Create non-root user
RUN addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/email-ingest-worker .

# Change ownership to non-root user
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Run the worker application
CMD ["./email-ingest-worker"]
