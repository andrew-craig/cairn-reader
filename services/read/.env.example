# PostgreSQL Configuration for Content Service Database
POSTGRES_DB_CONTENT=cairn_content
POSTGRES_USER_CONTENT=cairn_content
POSTGRES_PASSWORD_CONTENT=your_content_password_here

# PostgreSQL Configuration for RSS Fetcher Service Database
POSTGRES_DB_RSS=cairn_rss
POSTGRES_USER_RSS=cairn_rss
POSTGRES_PASSWORD_RSS=your_rss_password_here

# Database Configuration for Content Service
DB_PASSWORD_CONTENT=your_content_password_here

# Database Configuration for RSS Fetcher Service
DB_PASSWORD_RSS=your_rss_password_here
