# Content Service Configuration

# Server Configuration
PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USER=cairn_content
DB_PASSWORD=cairn_content_pass
DB_NAME=cairn_content
DB_SSL_MODE=disable

# Connection Pool Settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=2m

# Vault Configuration (for JWT authentication)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
# VAULT_ROLE_ID=your_role_id        # For production AppRole auth
# VAULT_SECRET_ID=your_secret_id    # For production AppRole auth
VAULT_AUTH_PATH=approle
JWT_PUBLIC_KEY_PATH=secret/data/jwt/public-key

# Ingest RSS Service Integration
INGEST_RSS_SERVICE_URL=http://localhost:8085
