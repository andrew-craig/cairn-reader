# Build stage
FROM golang:1.24-alpine AS builder

# Set GOTOOLCHAIN to auto to allow using newer Go versions
ENV GOTOOLCHAIN=auto

# Install build dependencies
RUN apk add --no-cache git

# Set working directory
WORKDIR /build/services/read

# Copy go mod files
COPY services/read/go.mod services/read/go.sum ./

# Copy pkg directory to match replace directive location (../../pkg from services/read)
COPY pkg/ ../../pkg/

# Download dependencies
RUN go mod download

# Copy source code
COPY services/read/content/ ./content/

# Build the worker application
WORKDIR /build/services/read/content
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o /build/content-worker ./cmd/worker

# Final stage
FROM alpine:latest

# Install ca-certificates for HTTPS
RUN apk --no-cache add ca-certificates

# Create non-root user
RUN addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/content-worker .

# Change ownership to non-root user
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Run the worker application
CMD ["./content-worker"]
